{
  "name": "antigravity-chinese",
  "version": "1.2.2",
  "description": "Zero-dependency runtime Chinese/English UI switcher for Google Antigravity desktop app (CDP & ASAR patch modes).",
  "type": "module",
  "scripts": {
    "cdp": "node launch-cdp.mjs",
    "cdp:restart": "node launch-cdp.mjs --restart",
    "cdp:attach": "node launch-cdp.mjs --attach-only",
    "shortcut": "node launch-cdp.mjs --shortcut",
    "patch": "node patch.mjs",
    "restore": "node restore.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "antigravity",
    "i18n",
    "chinese",
    "localization",
    "electron",
    "cdp"
  ],
  "license": "MIT"
}
