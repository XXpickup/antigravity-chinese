  "patterns": [
    {
      "regex": "^Your Plan:\\s*(.+)$",
      "replace": "当前方案：$1"
    },
    {
      "regex": "^You have used some of your weekly limit, it will fully refresh in (.+)\\.$",
      "replace": "已使用部分每周额度，将在 $1 后完全刷新。",
      "translateTimeUnits": true
    },
    {
      "regex": "^You have used some of your 5-hour limit, it will fully refresh in (.+)\\.$",
      "replace": "已使用部分 5 小时额度，将在 $1 后完全刷新。",
      "translateTimeUnits": true
    },
    {
      "regex": "^Send feedback as\\s+(.+)$",
      "replace": "以 $1 的身份发送反馈"
    },
    {
      "regex": "^Show (\\d+) breakdowns?$",
      "replace": "展开 $1 项明细"
    },
    {
      "regex": "^Hide (\\d+) breakdowns?$",
      "replace": "收起 $1 项明细"
    },
    {
      "regex": "^(\\d+)\\s+files?\\s+changed$",
      "replace": "$1 个文件已更改"
    },
    {
      "regex": "^(\\d+)\\s*s\\s+ago$",
      "replace": "$1 秒前"
    },
    {
      "regex": "^(\\d+)\\s*m\\s+ago$",
      "replace": "$1 分钟前"
    },
    {
      "regex": "^(\\d+)\\s*h\\s+ago$",
      "replace": "$1 小时前"
    },
    {
      "regex": "^(\\d+)\\s*d\\s+ago$",
      "replace": "$1 天前"
    }
  ],
